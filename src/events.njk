---
layout: layouts/base.njk
title: Events
description: Kennedy-King neighborhood meetings, block parties, clean-ups, and get-togethers, all on one community calendar.
heading: Events
lead: Neighborhood meetings, block parties, clean-ups, and get-togethers. Everything goes on the community calendar.
---
{% from "partials/macros.njk" import ext %}
{%- set calId = site.calendar.id | urlencode -%}
{%- set embed = "https://calendar.google.com/calendar/embed?src=" + calId + "&ctz=America%2FIndiana%2FIndianapolis&showTitle=0&showPrint=0&showCalendars=0&showTz=0" -%}
{%- set ics = "calendar.google.com/calendar/ical/" + calId + "/public/basic.ics" -%}

<nav class="jump-links container" aria-label="On this page">
  <a href="#meeting">Monthly meeting</a>
  <a href="#calendar">Calendar</a>
  <a href="#past-events">Past events</a>
</nav>

<section class="container meeting-wrap" id="meeting" aria-labelledby="meeting-title">
  {% include "partials/meeting-card.njk" %}

  {# TODO: confirm what a typical meeting covers. #}
  <div class="meeting-extra">
    <h3>What to expect</h3>
    <ul class="checklist">
      <li>Updates from the board and committees</li>
      <li>News from the city and partner organizations</li>
      <li>Time for neighbors' questions and ideas</li>
    </ul>
  </div>
</section>

<section class="section section--alt" id="calendar" aria-labelledby="calendar-title">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 id="calendar-title">Community calendar</h2>
        <p>Kept up to date by the board. Select any event for details.</p>
      </div>
    </div>

    {# js/main.js loads the list view on phones and the month view on wider screens. #}
    <div class="calendar-embed">
      <iframe title="Kennedy-King community calendar" loading="lazy"
              data-src-agenda="{{ embed }}&amp;mode=AGENDA"
              data-src-month="{{ embed }}&amp;mode=MONTH"></iframe>
      <noscript><iframe title="Kennedy-King community calendar" src="{{ embed }}&amp;mode=AGENDA"></iframe></noscript>
    </div>

    <div class="btn-row calendar-actions">
      {{ ext("https://calendar.google.com/calendar/u/0?cid=" + (site.calendar.id | base64), "Add to Google Calendar", "btn btn--secondary btn--small") }}
      {{ ext("webcal://" + ics, "Subscribe in Apple or Outlook", "btn btn--secondary btn--small") }}
    </div>

    <div class="callout">
      <h3>Have an event to add?</h3>
      <p>Email <a href="{{ site.email | mailto('Event for the community calendar') }}">{{ site.email }}</a> with the date, time, place, and a short description.</p>
    </div>
  </div>
</section>

<section class="section" id="past-events" aria-labelledby="past-title">
  <div class="container">
    <h2 id="past-title">Past events</h2>
    {# Past events come from _data/past_events.yml #}
    {%- for ev in past_events %}
    <article class="past-event">
      <h3>{{ ev.title }}</h3>
      <p class="note"><time datetime="{{ ev.date | isoDate }}">{{ ev.date | longDate }}</time></p>
      <p>{{ ev.summary }}</p>
      {%- if ev.sponsors %}
      <h4>Thank you to our sponsors</h4>
      <ul class="sponsor-list">
        {%- for s in ev.sponsors %}
        <li>{{ ext(s.url, s.name) }}</li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </article>
    {%- endfor %}
  </div>
</section>
