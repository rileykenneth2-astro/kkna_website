<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="{{ site.name }}, home">
      <img src="/images/logo-mark.png" alt="" width="317" height="447">
      <span>
        <span class="brand__name">{{ site.shortName }}</span>
        <span class="brand__sub">Neighborhood Association</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      Menu
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
        <li><a class="btn btn--primary btn--small" href="{{ site.navButton.url }}"{% if page.url == site.navButton.url %} aria-current="page"{% endif %}>{{ site.navButton.label }}</a></li>
      </ul>
    </nav>
  </div>
</header>
